# Copy this file to .env before starting the project.
# AI configuration is optional: without it, the site starts and translation
# asks you to configure an AI provider when clicked.
# To enable translation, uncomment and fill in all four values below.
# AI_API_FORMAT=chat-completions
# AI_API_BASE_URL=https://your-provider.example/v1
# AI_MODEL=your-provider-model-id
# AI_API_KEY=your-provider-api-key

# Caddy serves the whole site at https://char300.com and proxies to this loopback port.
HOST=127.0.0.1
PORT=8787
APP_ORIGIN=https://char300.com

# For local Vite development, change APP_ORIGIN to http://127.0.0.1:5173.
# AI_API_BASE_URL is the provider's API prefix, excluding the final
# /chat/completions or /responses path. Use an HTTPS URL.
# For a Responses-only model, set AI_API_FORMAT=responses.
# Keep real API keys only in .env, which is ignored by Git.
