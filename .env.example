# Copy to .env and set values for the selected provider.
AI_API_FORMAT=chat-completions
AI_API_BASE_URL=https://api.deepseek.com
AI_MODEL=replace-with-model-id
AI_API_KEY=replace-with-api-key

# Bind to 0.0.0.0 only when trusted LAN devices should reach this host.
HOST=127.0.0.1
PORT=8787

# Set this to the exact page origin when using a reverse proxy or Vite.
# APP_ORIGIN=http://127.0.0.1:5173
