# Copy this file to .env before starting the project.
# Replace the model ID and API key below with values from your provider.
# .env is local to this server and must not be committed.
AI_API_FORMAT=chat-completions
AI_API_BASE_URL=https://api.deepseek.com
AI_MODEL=replace-with-model-id
AI_API_KEY=replace-with-api-key

# Caddy serves the whole site at https://char300.com and proxies to this loopback port.
HOST=127.0.0.1
PORT=8787
APP_ORIGIN=https://char300.com

# For local Vite development, change APP_ORIGIN to http://127.0.0.1:5173.
# For OpenAI Responses, use AI_API_FORMAT=responses and
# AI_API_BASE_URL=https://api.openai.com/v1; set a supported AI_MODEL.
