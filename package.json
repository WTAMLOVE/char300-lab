{
  "name": "char300-lab",
  "version": "0.4.0",
  "packageManager": "pnpm@11.22.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "node --env-file-if-exists=.env server/index.mjs --api-only",
    "build": "tsc && vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.ts",
    "test:coverage": "node --test --experimental-test-coverage tests/*.test.ts",
    "check:version": "node scripts/check-version.mjs",
    "benchmark": "node scripts/performance-baseline.mjs",
    "generate:archives": "node scripts/generate-synthetic-archives.mjs",
    "check": "pnpm run check:version && pnpm run test && pnpm exec tsc --noEmit && pnpm run build"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  }
}
